# ---- Neon Postgres ----
# Neon console -> project -> Connection Details.
# Use the pooled connection string for DATABASE_URL (app runtime),
# and the direct (unpooled) connection string for DIRECT_URL (used by Prisma Migrate).
DATABASE_URL="postgresql://user:password@ep-example-pooler.neon.tech/popcorn?sslmode=require"
DIRECT_URL="postgresql://user:password@ep-example.neon.tech/popcorn?sslmode=require"

# ---- Firebase Admin (server) ----
# Firebase console -> Project Settings -> Service Accounts -> Generate new private key.
FIREBASE_PROJECT_ID="popcorn-app"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk-xxxxx@popcorn-app.iam.gserviceaccount.com"
# Base64-encode the full PEM private key (including BEGIN/END lines) before pasting it here:
#   node -e 'console.log(Buffer.from(`-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n`).toString("base64"))'
# Base64 avoids the raw multi-line PEM getting mangled by tools that parse KEY=VALUE lines
# (this bit us for real in the Cloud Run deploy pipeline -- see CLAUDE.md).
FIREBASE_PRIVATE_KEY_BASE64="<base64-encoded PEM>"

# ---- TMDB (server-only, never sent to client) ----
# themoviedb.org -> account -> Settings -> API -> request an API key (developer/personal use).
TMDB_API_KEY=""
TMDB_API_BASE_URL="https://api.themoviedb.org/3"
TMDB_IMAGE_BASE_URL="https://image.tmdb.org/t/p/"

# ---- Server ----
PORT=8080
CLIENT_ORIGIN="http://localhost:5173"

# ---- Client (Vite — must be prefixed VITE_) ----
# Firebase console -> Project Settings -> General -> your Web App config.
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN="popcorn-app.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="popcorn-app"
VITE_FIREBASE_APP_ID=""
VITE_API_BASE_URL="http://localhost:8080"
